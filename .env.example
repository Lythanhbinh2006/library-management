# =============================================================================
# Mẫu biến môi trường. Sao chép thành .env rồi ĐỔI HẾT mật khẩu:
#     cp .env.example .env        (hoặc chạy ./scripts/setup.sh để tự sinh mật khẩu mạnh ngẫu nhiên)
# File .env KHÔNG được commit lên GitHub (đã có trong .gitignore).
# Mật khẩu nên >= 16 ký tự, tránh ký tự $ # " ' \ và khoảng trắng.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_PASSWORD=doi-mat-khau-nay-admin-postgres
APP_DB_PASSWORD=doi-mat-khau-nay-role-library-app

# --- Ứng dụng web ---
SESSION_SECRET=chuoi-ngau-nhien-it-nhat-32-ky-tu-doi-ngay-di
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-mat-khau-admin-toi-thieu-12-ky-tu

# --- pgAdmin ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=doi-mat-khau-pgadmin

# --- Nginx / mạng ---
# Tên máy đưa vào chứng chỉ tự ký (hostname hoặc IP của máy chạy Docker)
SERVER_NAME=localhost
HTTP_PORT=80
# Nếu đổi HTTPS_PORT, phải sửa thêm dòng "return 301 https://$host..." trong nginx/nginx.conf
HTTPS_PORT=443
# Giao diện quản trị (pgAdmin/Grafana/Prometheus) chỉ mở trên loopback.
# Chạy Docker trong máy ảo và muốn truy cập từ máy thật: đặt 0.0.0.0 (cân nhắc rủi ro) hoặc dùng SSH tunnel.
ADMIN_BIND=127.0.0.1
